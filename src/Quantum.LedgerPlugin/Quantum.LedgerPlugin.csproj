<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Quantum.LedgerPlugin</PackageId>
    <Version>0.6.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Quantum.Plugin.Abstraction" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <PackageReference Include="NOF.Application" />
    <PackageReference Include="NOF.Contract" />
    <PackageReference Include="NOF.Domain" />
    <PackageReference Include="NOF.Infrastructure" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="plugin.json;wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="migrations\**\*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../LICENSE;../../NOTICE" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
